<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.loginutils.dal.mappers.UserMapper">

    <resultMap id="BaseResultMap" type="org.loginutils.dal.model.UserDo">
        <id column="UserId" property="userId" jdbcType="BIGINT"/>
        <result column="Email" property="email" jdbcType="VARCHAR"/>
        <result column="Username" property="username" jdbcType="VARCHAR"/>
        <result column="Password" property="password" jdbcType="VARCHAR"/>
        <result column="Status" property="status" jdbcType="TINYINT"/>
        <result column="Language" property="language" jdbcType="VARCHAR"/>
        <result column="PwdResetCount" property="pwdResetCount" jdbcType="INTEGER"/>
        <result column="PwdResetWindowStart" property="pwdResetWindowStart" jdbcType="TIMESTAMP"/>
        <result column="CreateTime" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="UpdateTime" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="LoginIp" property="loginIp" jdbcType="VARCHAR"/>
        <result column="LoginTime" property="loginTime" jdbcType="TIMESTAMP"/>
        <result column="FailedLoginCount" property="failedLoginCount" jdbcType="BIGINT"/>
        <result column="Memo" property="memo" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="findLogin" resultType="org.loginutils.dal.model.UserDo">
        SELECT *
        FROM k_user
        WHERE Username = #{username}
    </select>

    <select id="findById" resultType="org.loginutils.dal.model.UserDo">
        SELECT *
        FROM k_user
        WHERE UserId = #{userId}
    </select>

    <select id="selectByUsernameOrEmail" resultType="org.loginutils.dal.model.UserDo">
        SELECT *
        FROM k_user
        WHERE Username = #{email} OR Email = #{email}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="userId" keyColumn="UserId">
        INSERT INTO k_user (Email, Username, Password, Status, Language, PwdResetCount, PwdResetWindowStart, CreateTime, UpdateTime)
        VALUES (#{email}, #{username}, #{password}, #{status}, #{language}, #{pwdResetCount}, #{pwdResetWindowStart}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="org.loginutils.dal.model.UserDo" keyProperty="userId" keyColumn="UserId"
            flushCache="true">
        UPDATE k_user
        <set>
            <if test="@org.loginutils.dal.utils.Ognl@check(password)">
                Password = #{password},
            </if>
            <if test="@org.loginutils.dal.utils.Ognl@check(status)">
                Status = #{status},
            </if>
            <if test="@org.loginutils.dal.utils.Ognl@check(failedLoginCount)">
                FailedLoginCount = #{failedLoginCount},
            </if>
            <if test="@org.loginutils.dal.utils.Ognl@checkNotNull(memo)">
                Memo = #{memo},
            </if>
            <if test="@org.loginutils.dal.utils.Ognl@checkNotNull(language)">
                Language = #{language},
            </if>
            <if test="@org.loginutils.dal.utils.Ognl@check(email)">
                Email = #{email},
            </if>
            <if test="@org.loginutils.dal.utils.Ognl@checkNotNull(pwdResetCount)">
                PwdResetCount = #{pwdResetCount},
            </if>
            <if test="pwdResetWindowStart != null or pwdResetWindowStart == null">
                <!-- If it allows null, we'll map it straight, else we just do standard if != null -->
            </if>
            <if test="pwdResetWindowStart != null">
                PwdResetWindowStart = #{pwdResetWindowStart},
            </if>
<!--            <if test="@org.loginutils.dal.utils.Ognl@check(phone)">-->
<!--                Phone = #{phone},-->
<!--            </if>-->
<!--            <if test="@org.loginutils.dal.utils.Ognl@check(parentId)">-->
<!--                ParentId = #{parentId},-->
<!--            </if>-->
<!--            <if test="@org.loginutils.dal.utils.Ognl@check(roleId)">-->
<!--                RoleId = #{roleId},-->
<!--            </if>-->
<!--            <if test="@org.loginutils.dal.utils.Ognl@check(nickname)">-->
<!--                Nickname = #{nickname},-->
<!--            </if>-->
<!--            Updater = #{updater},-->
            UpdateTime = NOW()
        </set>
        WHERE UserId = #{userId}
    </update>

    <update id="increaseFailedLogin">
        UPDATE k_user
        SET FailedLoginCount = FailedLoginCount + 1,
            LoginTime        = NOW()
        WHERE UserId = #{userId}
    </update>

    <update id="updateLogin" keyProperty="userId" keyColumn="UserId" flushCache="true">
        UPDATE k_user
        SET LoginTime        = NOW(),
            FailedLoginCount = 0,
            LoginIp = #{loginIp}
        WHERE UserId = #{userId}
    </update>

</mapper>
